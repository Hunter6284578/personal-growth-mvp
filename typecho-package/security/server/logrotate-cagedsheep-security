/var/log/security-audit.log
/var/log/nginx/*.log
/var/log/php8.1-fpm/*.log
/var/log/mysql/*.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    dateext
    sharedscripts
    create 0640 root adm
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 $(cat /run/nginx.pid) || true
    endscript
}
